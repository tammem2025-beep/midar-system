# Safe development template. Never commit your real .env file.
APP_ENV=development
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
TOKEN_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///./midar.db
# MEDIA_DIR=  # optional; leave unset to use the built-in data/media directory
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=104857600
LOGIN_WINDOW_MINUTES=15
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=30

# Optional: Telegram bot token. Keep server-side only.
TELEGRAM_BOT_TOKEN=

# Optional: Google OpenID Connect credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Optional Meta OAuth for managed Facebook Pages and linked Instagram Professional media.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/meta/callback
META_GRAPH_API_VERSION=v26.0

# Provider tokens are encrypted at rest. Desktop M generates this key once automatically.
# For hosted deployment, generate once and store in a secret manager; never rotate without re-encrypting tokens.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_TOKEN_ENCRYPTION_KEY=
